class Solution:
    def maximumProduct(self, nums: List[int]) -> int:
        output = sorted(nums)
        
        # Teen sabse bade numbers ka product OR Do sabse chhote + 1 sabse bada number
        return max(
            output[-1] * output[-2] * output[-3],
            output[0] * output[1] * output[-1]
        )
